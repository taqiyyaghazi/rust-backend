# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8080

# PostgreSQL Configuration (matches docker-compose.yml defaults)
POSTGRES_USER=ddd_user
POSTGRES_PASSWORD=ddd_password
POSTGRES_DB=ddd_backend
POSTGRES_PORT=5432

# SQLx Database Connection String
DATABASE_URL=postgres://ddd_user:ddd_password@localhost:5432/ddd_backend

# Structured Logging
RUST_LOG=info,api=debug,identity=debug,shared_kernel=debug,tower_http=info

# CORS (comma-separated allowed origins; leave empty to disallow cross-origin requests)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Swagger UI / OpenAPI (set to true in local development)
ENABLE_SWAGGER_UI=true
